{
  "name": "aqua-flow-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone-assets.js",
    "start": "next start",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "seed": "npx tsx src/backend/db/seed.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migration:create": "sequelize-cli migration:generate",
    "backup": "node backup.js backup",
    "restore": "node backup.js restore"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.3",
    "@sentry/nextjs": "^10.78.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.7",
    "lucide-react": "^1.25.0",
    "moment-timezone": "^0.6.3",
    "next": "^15.5.29",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.82.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.0.0",
    "sqlite3": "^5.1.7",
    "tsx": "^4.23.8",
    "typescript": "^5.0.0",
    "vite": "^6.0.4",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.0",
    "@tailwindcss/oxide-linux-x64-musl": "^4.0.0"
  }
}
